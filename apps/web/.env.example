# Public URL used for canonical links, sitemap and robots.txt
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where demo/trial/newsletter submissions are stored (newline-delimited JSON)
LEADS_DIR=./data
# Dashboard: where the DevyTalk calling engine (aicallingagent) is reachable from this server.
# Server-side only; never exposed to the browser.
DEVYTALK_API_URL=http://localhost:8000
# How many proxies of your own stand in front of this server (load balancer, CDN).
# The sign-in and form limits count attempts per address as the outermost of them
# reports it. 0 = nothing in front: all visitors share one limit.
TRUSTED_PROXY_HOPS=1
